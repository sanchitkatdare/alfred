// Cloudflare Pages config. Functions live in ./functions, shared server code in ./server.
// Search vectors and story text are static files in public/data (see scripts/seed.ts), so no Vectorize binding.
{
  "name": "alfred",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI", "remote": true }
}
